# Optional configuration. The application uses process.env.
# Start with: node --env-file=.env --import tsx src/server.ts
PORT=4317
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional explicit selection. Unset selects the smallest installed text Qwen <=16GB.
QWEN_MODEL=qwen3:14b-q8_0
RENDER_CONCURRENCY=2
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# BONSAI_BASE_URL=http://127.0.0.1:8000
# BONSAI_MODEL=your-local-bonsai-model-id
# Enable only after ensuring Bonsai and the renderer fit in memory.
BONSAI_MEMORY_SAFE=false

# OpenAI-compatible Bonsai JSON response format; false for servers without JSON mode.
BONSAI_JSON_MODE=true
